# Copy this file to .env and fill in the required values.

# Required secrets: Docker Compose refuses to start while they are empty.
CUSTOMER_DB_PASSWORD=
ACCOUNT_DB_PASSWORD=

# Optional host ports (defaults shown)
CUSTOMER_SERVICE_HOST_PORT=8081
ACCOUNT_SERVICE_HOST_PORT=8082
CUSTOMER_DB_HOST_PORT=5434
ACCOUNT_DB_HOST_PORT=5435
KAFKA_HOST_PORT=9094
